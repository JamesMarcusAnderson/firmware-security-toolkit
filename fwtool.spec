# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for fwtool — one-file executable, no dependencies.

Build:  pip install pyinstaller
        pyinstaller fwtool.spec
Output: dist/fwtool  (dist/fwtool.exe on Windows)
"""
block_cipher = None

a = Analysis(
    ['fwtool/__main__.py'],
    pathex=[],
    binaries=[],
    datas=[],
    hiddenimports=[],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure, cipher=block_cipher)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.zipfiles,
    a.datas,
    [],
    name='fwtool',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
